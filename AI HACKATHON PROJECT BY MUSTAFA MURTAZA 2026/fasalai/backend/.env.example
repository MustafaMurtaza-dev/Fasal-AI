# ─── FasalAI Backend Environment ───
# Copy this file to .env and fill in your values

# Routeway AI LLM (required for AI features)
ROUTEWAY_API_KEY=your_routeway_api_key_here
ROUTEWAY_API_URL=https://api.routeway.ai/v1

# AI Models
PRIMARY_MODEL=gpt-oss-120b:free
FAST_MODEL=gpt-oss-120b:free
BACKUP_MODEL=deepseek-r1:free

# OpenWeatherMap (optional — mock data used if blank)
OPENWEATHER_API_KEY=

# Tuning
LLM_MAX_RETRIES=2
LLM_TIMEOUT=60
MAX_IMAGE_SIZE_MB=10

# Debug
DEBUG=true
